<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Card de confirmação -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Ícone de confirmação -->
                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check_circle"
                    android:tint="#4CAF50"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="Ícone de confirmação" />

                <!-- Título -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Confirmar Endereço"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#2626BF"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- Subtítulo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Revise as informações abaixo antes de confirmar"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />

                <!-- Linha divisória -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="20dp" />

                <!-- Informações do endereço em formato de resumo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📋 DADOS DO ENDEREÇO"
                    android:textSize="12sp"
                    android:textColor="#9E9E9E"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvResumoEndereco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#212121"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="16dp" />

                <!-- Detalhes completos do endereço -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔍 DETALHES COMPLETOS"
                    android:textSize="12sp"
                    android:textColor="#9E9E9E"
                    android:layout_marginBottom="8dp" />

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1"
                    android:layout_marginBottom="16dp">

                    <!-- CEP -->
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CEP:"
                            android:textStyle="bold"
                            android:textColor="#616161"
                            android:layout_marginEnd="16dp" />
                        <TextView
                            android:id="@+id/tvCep"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#212121" />
                    </TableRow>

                    <!-- Logradouro -->
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Logradouro:"
                            android:textStyle="bold"
                            android:textColor="#616161"
                            android:layout_marginEnd="16dp" />
                        <TextView
                            android:id="@+id/tvLogradouro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#212121" />
                    </TableRow>

                    <!-- Número -->
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Número:"
                            android:textStyle="bold"
                            android:textColor="#616161"
                            android:layout_marginEnd="16dp" />
                        <TextView
                            android:id="@+id/tvNumero"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#212121" />
                    </TableRow>

                    <!-- Complemento -->
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Complemento:"
                            android:textStyle="bold"
                            android:textColor="#616161"
                            android:layout_marginEnd="16dp" />
                        <TextView
                            android:id="@+id/tvComplemento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#212121" />
                    </TableRow>

                    <!-- Bairro -->
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bairro:"
                            android:textStyle="bold"
                            android:textColor="#616161"
                            android:layout_marginEnd="16dp" />
                        <TextView
                            android:id="@+id/tvBairro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#212121" />
                    </TableRow>

                    <!-- Cidade/UF -->
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cidade/UF:"
                            android:textStyle="bold"
                            android:textColor="#616161"
                            android:layout_marginEnd="16dp" />
                        <TextView
                            android:id="@+id/tvCidadeUf"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#212121" />
                    </TableRow>
                </TableLayout>

                <!-- Linha divisória -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="20dp" />

                <!-- Botões de ação -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnEditar"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Editar"
                        android:textAllCaps="false"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnConfirmar"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Confirmar"
                        android:textAllCaps="false"
                        android:backgroundTint="#4CAF50" />
                </LinearLayout>

                <!-- Botão cancelar -->
                <Button
                    android:id="@+id/btnCancelar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Cancelar"
                    android:textAllCaps="false"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:textColor="#F44336"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>